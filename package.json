{
  "name": "@alexify/metaschema",
  "version": "1.0.0",
  "description": "Zero-dependency metadata schema and interface definition language (IDL) for Node.js and browsers — data validation, domain models and TypeScript generation",
  "license": "MIT",
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/metaschema.git"
  },
  "homepage": "https://metaschema.vercel.app/",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/metaschema/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js",
    "./src/runtime/node.js": "./src/runtime/browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 90 --branches 90 --functions 90 --reporter text --reporter lcov node --test tests/unit/*.test.js",
    "test:types": "tsd",
    "check:dts": "tsc --noEmit --strict --target es2022 --skipLibCheck false index.d.ts",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "prepublishOnly": "pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run test:types && pnpm run check:dts",
    "release": "pnpm publish"
  },
  "tsd": {
    "directory": "tests/types"
  },
  "keywords": [
    "schema",
    "metaschema",
    "metadata",
    "idl",
    "interface-definition-language",
    "dsl",
    "validation",
    "data-validation",
    "domain-model",
    "model",
    "typescript",
    "typescript-definitions",
    "zero-dependency",
    "browser",
    "metarhia"
  ],
  "devDependencies": {
    "c8": "^10.1.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsd": "^0.31.2",
    "typescript": "^5.9.3"
  }
}
