{
  "name": "@alexify/metaschema",
  "version": "2.0.0",
  "description": "Zero-dependency metadata schema and interface definition language (IDL) for Node.js and browsers — data validation, domain models and TypeScript generation",
  "license": "MIT",
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/metaschema.git"
  },
  "homepage": "https://metaschema.vercel.app/",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/metaschema/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js",
    "./src/runtime/node.js": "./src/runtime/browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./locales/en": {
      "types": "./src/locales/en.d.ts",
      "default": "./src/locales/en.js"
    },
    "./locales/uk": {
      "types": "./src/locales/uk.d.ts",
      "default": "./src/locales/uk.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 98 --statements 98 --branches 90 --functions 100 --reporter text --reporter lcov node --test tests/unit/*.test.js",
    "test:types": "tsd",
    "check:dts": "tsc --noEmit --strict --target es2022 --skipLibCheck false index.d.ts src/locales/en.d.ts src/locales/uk.d.ts",
    "lint": "oxlint src tests scripts bench",
    "format": "oxfmt src tests scripts bench",
    "format:check": "oxfmt --check src tests scripts bench",
    "size": "node scripts/size.js",
    "bench": "node bench/bench.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run test:types && pnpm run check:dts",
    "release": "pnpm publish"
  },
  "tsd": {
    "directory": "tests/types"
  },
  "keywords": [
    "schema",
    "metaschema",
    "metadata",
    "idl",
    "interface-definition-language",
    "dsl",
    "validation",
    "data-validation",
    "domain-model",
    "model",
    "typescript",
    "typescript-definitions",
    "zero-dependency",
    "browser",
    "metarhia"
  ],
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.75.0",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  }
}
