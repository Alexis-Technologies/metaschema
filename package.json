{
  "name": "metaschema",
  "version": "2.2.2",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "description": "Metadata Schema and Interface Definition Language (IDL)",
  "license": "MIT",
  "keywords": [
    "interface",
    "definition",
    "metarhia",
    "idl",
    "dsl",
    "schema",
    "metadata"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metarhia/metaschema.git"
  },
  "bugs": {
    "url": "https://github.com/metarhia/metaschema/issues",
    "email": "timur.shemsedinov@gmail.com"
  },
  "homepage": "https://metarhia.com",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/tshemsedinov"
  },
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js",
    "./src/runtime/node.js": "./src/runtime/browser.js"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "src/"
  ],
  "readmeFilename": "README.md",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 90 --branches 90 --functions 90 --reporter text --reporter lcov node --test tests/unit/*.test.js",
    "check:dts": "tsc --noEmit --strict --target es2022 --skipLibCheck false index.d.ts",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.5"
}
